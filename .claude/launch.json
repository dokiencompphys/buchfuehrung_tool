{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "backend",
      "runtimeExecutable": "uv",
      "runtimeArgs": ["run", "--directory", "backend", "uvicorn", "buchfuehrung.main:app", "--host", "0.0.0.0", "--port", "8000"],
      "port": 8000
    },
    {
      "name": "app-web",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "app", "run", "web", "--", "--port", "8081"],
      "port": 8081
    }
  ]
}
